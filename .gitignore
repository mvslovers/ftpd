*.s
*.o
*.d
*.jcl
!samplib/*.jcl
compile_commands.json

# mbt 2 connection settings, incl. MBT_MVS_PASS -- .env plus the per-target
# variants (.env.mvsdev, ...). mbt 3 keeps MVS systems in ~/.mbt/targets.toml;
# these stay ignored for as long as a working copy still holds one.
.env
.env.*

# Generated build state -- the committed lock lives at the root (mbt.lock).
.mbt/
dist/
build/
*.xmit

.cache/
.DS_Store
